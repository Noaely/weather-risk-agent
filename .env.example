# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Agent model settings (Stage 4). Sonnet is the default for demo latency; switch to
# claude-opus-5-5 if the eval shows it is needed.
AGENT_MODEL=claude-sonnet-5-5
# low | medium | high (medium = Anthropic's starting point for multi-step tool use)
AGENT_EFFORT=medium
# adaptive (model decides how much to think; the only option on Opus 5.5)
# between_tools (no extended thinking; Sonnet 5.5 only, effort high or below)
AGENT_THINKING=adaptive
# Server-side refusal fallback (beta). on | off
AGENT_FALLBACKS=on

# The analysis period ends with this year ("last year" in questions; scores use the 10 years up to it).
# Pinned to 2025 because the repo ships a fixed 2016-2025 database snapshot (data/weather.db). Without
# it, the period follows today's date, and from 1 January 2027 it would ask for 2026 data the snapshot
# does not contain (every metric would become "unknown"). Remove it only after re-running ingestion.
ANALYSIS_LAST_YEAR=2025

# Generic User-Agent for api.weather.gov (required by NWS). Do not put a personal email here
# unless you want NWS to be able to contact you.
NWS_USER_AGENT=hub-weather-risk-agent/0.1
