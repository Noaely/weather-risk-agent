# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Agent model settings (Stage 4). Sonnet is the default for demo latency; switch to
# claude-opus-5-5 if the eval shows it is needed.
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium

# Generic User-Agent for api.weather.gov (required by NWS). Do not put a personal email here
# unless you want NWS to be able to contact you.
NWS_USER_AGENT=hub-weather-risk-agent/0.1
